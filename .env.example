# Copie para .env (o setup.ps1 faz isso sozinho se .env nao existir). Nunca coloque chaves de API aqui:
# este projeto nao usa nenhum servico pago.

# Sobrescreve config.yaml quando preenchido
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
COMFYUI_HOST=http://127.0.0.1:8188

# Pasta da sua instalacao do ComfyUI (usada pelo run.ps1 para iniciar o servidor). Deixe vazio para iniciar manualmente.
COMFYUI_PATH=
# Argumentos extras ao iniciar o ComfyUI pelo run.ps1
COMFYUI_ARGS=--listen 127.0.0.1 --port 8188

# Pastas de dados (opcional). Podem ficar em QUALQUER disco, de preferencia FORA da Area de Trabalho e do OneDrive
# (sincronizadores e antivirus bloqueiam arquivos recem-gravados e causam "Acesso negado"). Aceita %USERPROFILE% e ~.
# Isto NAO mexe no .venv, no ComfyUI nem nos modelos. Vazio = pastas padrao dentro do projeto.
WIF_PROJECTS_DIR=
WIF_OUTPUTS_DIR=
WIF_TEST_OUTPUT_DIR=
